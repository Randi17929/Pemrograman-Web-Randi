### Variabel URL Utama (Pastikan Laragon sudah menyala)
@baseUrl = http://localhost/pemweb-obe/api/jadwal.php

### ==========================================
### 1. READ ALL (GET Collection)
### Ekspektasi: Status 200 OK, memunculkan semua data jadwal
### ==========================================
GET {{baseUrl}}
Accept: application/json


### ==========================================
### 2. READ WITH FILTER (GET)
### Ekspektasi: Status 200 OK, hanya memunculkan jadwal ke Pulau Bunyu
### ==========================================
GET {{baseUrl}}?tujuan=Pulau%20Bunyu
Accept: application/json


### ==========================================
### 3. READ BY ID (GET)
### Ekspektasi: Status 200 OK, menampilkan satu detail armada
### ==========================================
GET {{baseUrl}}?id=1
Accept: application/json


### ==========================================
### 4. CREATE (POST) - Tambah Jadwal Baru
### Ekspektasi: Status 201 Created, data berhasil masuk database
### ==========================================
POST {{baseUrl}}
Content-Type: application/json
Accept: application/json

{
    "armada_id": 1,
    "pelabuhan_id": 2,
    "harga": 150000,
    "berangkat": "08:00:00",
    "tiba": "09:30:00",
    "lokasi": "Dermaga 1"
}


### ==========================================
### 5. UPDATE (PUT) - Ubah Harga Tiket
### Ekspektasi: Status 200 OK, harga berhasil diperbarui
### ==========================================
PUT {{baseUrl}}?id=1
Content-Type: application/json
Accept: application/json

{
    "harga": 175000
}


### ==========================================
### 6. ERROR 404 (DELETE INVALID ID)
### Ekspektasi: Status 404 Not Found, menguji penolakan data fiktif
### ==========================================
DELETE {{baseUrl}}?id=9999
Accept: application/json


### ==========================================
### 7. ERROR 422 (POST INVALID PAYLOAD)
### Ekspektasi: Status 422 Unprocessable Entity, menguji penolakan input kosong
### ==========================================
POST {{baseUrl}}
Content-Type: application/json
Accept: application/json

{
    "harga": 150000
}